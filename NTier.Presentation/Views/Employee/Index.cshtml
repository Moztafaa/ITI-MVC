@model IEnumerable<NTier.BLL.ViewModels.EmployeeVM>

@{
    ViewData["Title"] = "Employees";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Employee List</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Add New Employee"]</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>@SharedLocalizer["Name"]</th>
                    <th>@SharedLocalizer["Gender"]</th>
                    <th>@SharedLocalizer["Salary"]</th>
                    <th>@SharedLocalizer["Address"]</th>
                    <th>@SharedLocalizer["Department"]</th>
                    <th>@SharedLocalizer["Actions"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>@employee.EmployeeId</td>
                        <td>@employee.Name</td>
                        <td>@employee.Gender</td>
                        <td>@employee.Salary.ToString("C")</td>
                        <td>@employee.Address</td>
                        <td>@(employee.Department?.Name ?? "N/A")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@employee.EmployeeId"
                               class="btn btn-sm btn-secondary">@SharedLocalizer["Details"]</a>
                            <a asp-action="Edit" asp-route-id="@employee.EmployeeId"
                               class="btn btn-sm btn-info">@SharedLocalizer["Edit"]</a>
                            <a asp-action="DeleteEmployee" asp-route-id="@employee.EmployeeId"
                               class="btn btn-sm btn-danger">@SharedLocalizer["Delete"]</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">No Employees Found</h4>
            <p>There are currently no employees in the system. Click "Add New Employee" to create one.</p>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>
